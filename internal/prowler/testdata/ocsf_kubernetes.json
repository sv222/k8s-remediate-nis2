    "finding_info": {
      "analytic": {
        "category": "rbac",
        "name": "Cluster role binding does not grant the cluster-admin role",
        "type": "Rule",
        "type_id": 1,
        "uid": "rbac_cluster_admin_usage"
      },
      "created_time": 1795264756,
      "created_time_dt": "2026-11-21T12:39:16.122776",
      "desc": "RBAC ClusterRoleBindings that bind to the `cluster-admin` ClusterRole are identified, showing where subjects receive super-user permissions across all namespaces.",
      "title": "Cluster role binding does not grant the cluster-admin role",
      "types": [],
      "uid": "prowler-kubernetes-rbac_cluster_admin_usage-kind-demo-namespace: cluster-wide-cluster-admin"
    },
    "resources": [
      {
        "group": {
          "name": "rbac"
        },
        "labels": [],
        "name": "cluster-admin",
        "namespace": "cluster-wide",
        "type": "ClusterRoleBinding",
        "uid": "940e5385-fbad-48da-8e1d-c5ead722b695"
      }
    ],
    "category_name": "Findings",
    "category_uid": 2,
    "class_name": "Detection Finding",
    "class_uid": 2004,
    "remediation": {
      "desc": "Apply **least privilege**: replace `cluster-admin` with narrowly scoped Roles/ClusterRoles and bind per namespace. Reserve super-user access for break-glass, time-bound with approval and audit. Enforce **separation of duties**, review RBAC regularly, and monitor role/binding changes for **defense in depth**.",
      "references": [
        "https://hub.prowler.com/check/rbac_cluster_admin_usage"
      ]
    },
    "risk_details": "**Excessive `cluster-admin` grants** give full API control, risking:\n- Secret exfiltration (confidentiality)\n- RBAC tampering (integrity)\n- Destructive actions causing outages (availability)\n\nA compromised subject can escalate, persist via new bindings, and laterally impact all namespaces.",
    "time": 1795264756,
    "time_dt": "2026-11-21T12:39:16.122776",
    "type_uid": 200401,
    "type_name": "Detection Finding: Create"
  },
